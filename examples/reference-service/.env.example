# Local development only. Copy to .env (git-ignored). Never put real secrets here (SCR-015, SCR-016).
# Every APP_* variable the settings class reads is listed; commented lines use the default.
# tests/unit/test_env_example.py fails when this file and config.py disagree.
APP_ENVIRONMENT=local
APP_LOG_LEVEL=DEBUG
# APP_SERVICE_NAME=
# APP_HOST=127.0.0.1
# APP_PORT=8000
# APP_REQUEST_TIMEOUT_S=10
# APP_KEY_VAULT_URL=https://<vault-name>.vault.azure.net
