# syntax=docker/dockerfile:1
# Implements: TEC-014 (multi-stage, non-root numeric user, uv sync --locked --no-editable --no-dev,
# only the venv in the runtime stage), TEC-015 (images pinned by tag and digest), IGN-014 (no COPY . .),
# SCR-026 (no secrets in ARG/ENV). Source: doc 00 Dockerfile.
#
# VERIFY: doc 00 did not build this file. The REPLACE_WITH_DIGEST placeholders make the build fail
# on purpose until real digests are set. Resolve with: docker buildx imagetools inspect <image:tag>
# Also VERIFY that the uv image tag exists in your registry mirror.
ARG PYTHON_IMAGE=python:3.14-slim@sha256:REPLACE_WITH_DIGEST
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.9@sha256:REPLACE_WITH_DIGEST

FROM ${UV_IMAGE} AS uv

FROM ${PYTHON_IMAGE} AS builder
COPY --from=uv /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=0
WORKDIR /app
# Layer 1: third-party dependencies only; cached until uv.lock or pyproject.toml change
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --no-editable --no-dev
# Layer 2: the project itself, installed non-editable into the venv
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-editable --no-dev

FROM ${PYTHON_IMAGE} AS runtime
RUN groupadd --system --gid 10001 app \
    && useradd --system --uid 10001 --gid app --no-create-home --shell /usr/sbin/nologin app
WORKDIR /app
COPY --from=builder --chown=app:app /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    APP_HOST=0.0.0.0 APP_PORT=8000
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "{{ package_name }}.main"]
