# ===== Canonical .gitignore for Python services (docs/07-ignore-files.md) =====

# --- Secrets and local environment ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.jks
secrets/
credentials.json
.azure/

# --- Claude Code personal files (shared .claude/ files and .mcp.json ARE committed) ---
.claude/settings.local.json
CLAUDE.local.md

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# --- Tool caches and test output ---
.ruff_cache/
.mypy_cache/
.pytest_cache/
.hypothesis/
.import_linter_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
mutants/
.ipynb_checkpoints/

# --- Terraform (commit .terraform.lock.hcl; never commit state or plans) ---
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
*.auto.tfvars
terraform.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Eval and run outputs (datasets, evaluators, thresholds.yaml ARE committed) ---
evals/results/
evals/outputs/
evals/.cache/
reports/
sbom*.json
sbom*.xml

# --- Local data and logs ---
*.log
.local/
tmp/
*.sqlite3
*.db

# --- Editors and OS ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# --- repo-specific --- (additions only; one-line reason per entry)
