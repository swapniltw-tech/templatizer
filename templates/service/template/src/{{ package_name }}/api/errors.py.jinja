"""Problem-details error mapping: the only place exceptions become responses (API-014).

Implements: API-009 (RFC 9457, application/problem+json, type/title/status plus trace_id),
API-011 (no internals in bodies), API-013 (422 for validation; same shape for every error).
ASSUMPTION: `trace_id` carries the request correlation ID (docs 17 and 10 disagree on whether it
is the correlation ID or the OTel trace ID, docs/FINDINGS.md F-06). `type` is `about:blank`
(API-010) until stable problem-type URIs are published.
"""

from http import HTTPStatus

import structlog
from fastapi import FastAPI, Request
from fastapi.exceptions import RequestValidationError
from fastapi.responses import JSONResponse
from starlette.exceptions import HTTPException as StarletteHTTPException

from {{ package_name }}.api.middleware import get_request_id

PROBLEM_JSON = "application/problem+json"
_log = structlog.get_logger()


def problem(request: Request, status: int, extra: dict[str, object] | None = None) -> JSONResponse:
    """Build a problem-details response for `status`."""
    body: dict[str, object] = {
        "type": "about:blank",
        "title": HTTPStatus(status).phrase,
        "status": status,
        "trace_id": get_request_id(request.scope),
    }
    if extra:
        body.update(extra)
    return JSONResponse(body, status_code=status, media_type=PROBLEM_JSON)


async def _http_error(request: Request, exc: Exception) -> JSONResponse:
    assert isinstance(exc, StarletteHTTPException)  # noqa: S101  # narrowing for the handler API
    return problem(request, exc.status_code)


async def _validation_error(request: Request, exc: Exception) -> JSONResponse:
    assert isinstance(exc, RequestValidationError)  # noqa: S101  # narrowing for the handler API
    errors = [
        {"pointer": "/" + "/".join(str(p) for p in e["loc"]), "code": str(e["type"])}
        for e in exc.errors()
    ]
    return problem(request, 422, {"code": "validation_error", "errors": errors})


async def _unhandled_error(request: Request, exc: Exception) -> JSONResponse:
    _log.error("unhandled_exception", exc_info=exc)  # logged once, at the boundary (OBS-008)
    return problem(request, 500)


def install_error_handlers(app: FastAPI) -> None:
    """Register the problem-details handlers on the app."""
    app.add_exception_handler(StarletteHTTPException, _http_error)
    app.add_exception_handler(RequestValidationError, _validation_error)
    app.add_exception_handler(Exception, _unhandled_error)
