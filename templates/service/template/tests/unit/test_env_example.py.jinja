"""Keep .env.example and the settings class in sync (SCR-016, from doc 06)."""

import re
from pathlib import Path

from {{ package_name }}.config import Settings

LINE = re.compile(r"^#?\s*(APP_[A-Z0-9_]+)=", re.MULTILINE)
ENV_EXAMPLE = Path(__file__).resolve().parents[2] / ".env.example"


def test_env_example_lists_every_setting() -> None:
    documented = set(LINE.findall(ENV_EXAMPLE.read_text(encoding="utf-8")))
    expected = {f"APP_{name.upper()}" for name in Settings.model_fields}
    assert documented == expected
